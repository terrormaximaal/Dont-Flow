{
  "name": "dont-flow",
  "description": "A mobile web game built with Phaser 4 and TypeScript.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terrormaximaal/Dont-Flow.git"
